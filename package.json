{
  "name": "minecraft-bot",
  "productName": "Minecraft Bot",
  "version": "0.4.2-beta",
  "description": "Bot do Minecrafta (Mineflayer) sterowany komendami po polsku, z centrum sterowania",
  "main": "gui/main.js",
  "scripts": {
    "start": "node start.js",
    "gui": "electron .",
    "dist": "electron-builder --win --publish never",
    "release": "electron-builder --win --publish always"
  },
  "keywords": [
    "minecraft",
    "mineflayer",
    "bot"
  ],
  "author": "cezary-lonski",
  "license": "ISC",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.5.0",
    "electron-updater": "^6.8.11",
    "minecraft-data": "^3.119.0",
    "mineflayer": "^4.39.0",
    "mineflayer-collectblock": "^1.6.0",
    "mineflayer-pathfinder": "^2.4.5",
    "mineflayer-pvp": "^1.3.2",
    "vec3": "^0.2.0"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cezary-lonski/minecraft-bot.git"
  },
  "devDependencies": {
    "electron": "^45.2.2",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.cezarylonski.minecraftbot",
    "productName": "Minecraft Bot",
    "asar": false,
    "files": [
      "bot.js",
      "start.js",
      "gui/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "gui/icon.png",
      "artifactName": "Minecraft-Bot-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Minecraft Bot",
      "runAfterFinish": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "cezary-lonski",
        "repo": "minecraft-bot",
        "releaseType": "prerelease"
      }
    ]
  }
}
